# Base de datos Neon (Postgres). Reemplazá con tu cadena de conexión.
# Formato: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Resend
RESEND_API_KEY=re_tu_api_key
EMAIL_FROM=Concursos GCBA <onboarding@resend.dev>

# Admin heredado: se crea/migra como usuario rol 'admin' en la tabla usuarios.
ADMIN_USER=admin
ADMIN_PASS=cambiar-esta-clave
CONCURSOS_USER=concursos
CONCURSOS_PASS=cambiar-esta-clave

# Developer inicial (semilla): se crea como usuario rol 'developer' al arrancar.
# Desde /developer se pueden crear el resto de los usuarios.
DEVELOPER_USER=developer
DEVELOPER_PASS=cambiar-esta-clave-dev

# Secreto para firmar los tokens de sesión del panel (poné algo largo y aleatorio).
SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio

# CORS: URL del frontend en Vercel (coma-separado para varios orígenes)
FRONTEND_ORIGIN=http://localhost:3000
