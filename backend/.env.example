# Base de datos. Usá SQLite para local, Neon para producción.
# SQLite (local):  DATABASE_URL=sqlite:///./local.db
# Neon (producción):DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./local.db

# Resend (solo para producción)
RESEND_API_KEY=re_tu_api_key
EMAIL_FROM=Concursos GCBA <onboarding@resend.dev>

# Credenciales admin (cambiar en producción)
ADMIN_USER=admin
ADMIN_PASS=cambiar-esta-clave
CONCURSOS_USER=concursos
CONCURSOS_PASS=cambiar-esta-clave

# Developer inicial
DEVELOPER_USER=developer
DEVELOPER_PASS=cambiar-esta-clave-dev

# Secreto para firmar los tokens del panel (poné algo largo y aleatorio)
SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio

# CORS: URL del frontend
FRONTEND_ORIGIN=http://localhost:3000
