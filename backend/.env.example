# Base de datos Neon (Postgres). Reemplazá con tu cadena de conexión.
# Formato: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Resend
RESEND_API_KEY=re_tu_api_key
EMAIL_FROM=Concursos GCBA <onboarding@resend.dev>

# Credenciales admin (2 usuarios)
ADMIN_USER=admin
ADMIN_PASS=cambiar-esta-clave
CONCURSOS_USER=concursos
CONCURSOS_PASS=cambiar-esta-clave

# CORS: URL del frontend en Vercel (coma-separado para varios orígenes)
FRONTEND_ORIGIN=http://localhost:3000
